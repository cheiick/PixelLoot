APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

STRIPE_WEBHOOK_SECRET=
FEDAPAY_SECRET_KEY=
FEDAPAY_WEBHOOK_SECRET=
FEDAPAY_BASE_URL=https://sandbox-api.fedapay.com/v1
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# For Render, use a persistent disk path (for example /var/data/public) or a public S3-compatible bucket.
PUBLIC_STORAGE_DRIVER=local
# PUBLIC_STORAGE_PATH=/var/data/public
# PUBLIC_STORAGE_URL=https://your-render-domain.onrender.com/storage
# Store uploaded product, logo, and banner images in Cloudinary instead of the public disk:
IMAGE_STORAGE_DISK=public
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_KEY=your-api-key
# CLOUDINARY_SECRET=your-api-secret
# CLOUDINARY_SECURE=true
# CLOUDINARY_PREFIX=
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=
# For production, set CACHE_STORE=redis after enabling Redis and the PHP Redis extension.

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Optional: Mailtrap Email Sending API (takes precedence over panel SMTP settings).
# MAILTRAP_API_TOKEN=replace-with-your-mailtrap-email-sending-api-token
# MAILTRAP_API_URL=https://send.api.mailtrap.io/api/send
# MAILTRAP_CATEGORY=Transactional

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# AWS_URL=https://your-public-bucket-url
# AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
